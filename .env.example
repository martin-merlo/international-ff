# Copiar a .env y completar. Las VITE_* se inyectan en el bundle del cliente:
# no pongas nada secreto en ellas.

# Base pública del sitio, sin barra final. Con esto se arman las URLs absolutas
# de og:image / twitter:image. Si falta, el build se corta con un mensaje claro.
VITE_SITE_URL=https://www.internationalff.com

# Supabase
SUPABASE_URL=https://<project-id>.supabase.co
SUPABASE_PROJECT_ID=<project-id>
SUPABASE_PUBLISHABLE_KEY=<publishable-key>
VITE_SUPABASE_URL=https://<project-id>.supabase.co
VITE_SUPABASE_PROJECT_ID=<project-id>
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable-key>
